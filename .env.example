# Copy this file to .env and fill in your keys.
# Both keys are required.

# Google Gemini API key — https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Tavily search API key — https://app.tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# ---- Optional overrides (defaults shown) ----
# MODEL_NAME=gemini-3-pro-preview
# FAST_MODEL_NAME=gemini-2.5-flash
# MAX_ITERATIONS=3
# MAX_SEARCH_RESULTS=3
# SCRAPE_CHAR_LIMIT=2000

# Estimated USD per 1M tokens, used only for the report cost footer.
# PRICE_INPUT_PER_MILLION=1.25
# PRICE_OUTPUT_PER_MILLION=10.0

# LangSmith tracing is off unless you opt in. Nothing here is required to run.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=finsight
# Older LangChain builds read these names instead:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_PROJECT=finsight
